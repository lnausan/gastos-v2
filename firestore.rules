rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para transacciones - permitir acceso al propietario
    match /transactions/{document} {
      allow read, write: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        !('user_id' in resource.data)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    // Reglas para valores del dólar - permitir acceso al propietario
    match /dollarValues/{document} {
      allow read, write: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        !('user_id' in resource.data)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    // Reglas para meses cerrados - permitir acceso al propietario
    match /closedMonths/{document} {
      allow read, write: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        !('user_id' in resource.data)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    // Reglas para transacciones archivadas - permitir acceso al propietario
    match /archivedTransactions/{document} {
      allow read, write: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        !('user_id' in resource.data)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    // Regla de respaldo para cualquier otro documento
    match /{document=**} {
      allow read, write: if false; // Denegar acceso por defecto
    }
  }
} 